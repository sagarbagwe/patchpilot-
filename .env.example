# Required only for Gemini mode. Demo mode works without secrets.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: increases GitHub API limits and enables private repositories.
GITHUB_TOKEN=

# Safety switch. Keep false until you intentionally want PatchPilot to
# create branches, commits, and draft pull requests with GITHUB_TOKEN.
PATCHPILOT_ENABLE_WRITES=false
